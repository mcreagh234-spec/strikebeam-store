# AltCheckout — set these in Netlify → Site configuration → Environment variables (server-side only).
# Never commit the real secret; never expose these to the browser.
ALTCHECKOUT_STORE_ID=store_AIQtH--kMHLsI7nE
ALTCHECKOUT_ORIGIN=https://www.altcheckout.com
# 64 hex chars copied from the AltCheckout dashboard (shown once; rotatable). Leave empty here.
ALTCHECKOUT_SECRET=

# Optional — order confirmation emails via Resend. Until both are set, orders still go through,
# customers just won't receive a confirmation email.
RESEND_API_KEY=
ORDER_FROM_EMAIL=
